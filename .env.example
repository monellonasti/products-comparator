# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Origin the browser uses (Vite dev server in development, the public URL in production)
PUBLIC_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://comparator:comparator_dev@127.0.0.1:5432/comparator
DATABASE_POOL_MAX=10
SESSION_TTL_HOURS=168
# COOKIE_SECURE defaults to true in production

# Object storage (S3-compatible). Local: SeaweedFS (docker-compose or scripts/dev/wsl-seaweedfs.sh)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=comparator
S3_ACCESS_KEY_ID=comparator
S3_SECRET_ACCESS_KEY=comparator_dev_secret
S3_FORCE_PATH_STYLE=true
# Alternative for single-machine setups/tests: STORAGE_DRIVER=fs and STORAGE_FS_ROOT=.data/storage

# Visual search (local open-weight encoder, see docs/VISUAL_SEARCH.md)
VISION_ENABLED=true
VISION_MODEL=siglip2-base-p16-224
VISION_THREADS=2
VISION_CONCURRENCY=2
VISION_CACHE_DIR=.models
VISION_ALLOW_REMOTE_MODELS=true
VISION_WARMUP=true

# Worker
WORKER_CONCURRENCY=4
EMBED_QUEUE_SHARDS=1
IMAGE_FETCH_PER_HOST=2
IMAGE_FETCH_TIMEOUT_MS=20000
IMAGE_KEEP_ORIGINALS=false
# DEV ONLY: allow the local demo image server despite SSRF protection (must be empty in production)
IMAGE_FETCH_DEV_ALLOW=127.0.0.1:4010

PHOTO_SEARCH_RETENTION_HOURS=72
# Protects GET /metrics (send "Authorization: Bearer <token>"). Empty = metrics disabled.
METRICS_TOKEN=
LOG_LEVEL=info

# Tests: integration tests use this database (it is wiped!) and filesystem storage
TEST_DATABASE_URL=postgres://comparator:comparator_dev@127.0.0.1:5432/comparator_test

# libuv threadpool shared by sharp, file I/O and ONNX Runtime async runs
UV_THREADPOOL_SIZE=8
