{
  "name": "products-comparator",
  "version": "0.1.0",
  "private": true,
  "description": "Catalogo visivo unificato dei fornitori B2B con ricerca per foto e confronto offerte.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch --env-file-if-exists=.env src/server/index.ts",
    "dev:worker": "node --env-file-if-exists=.env src/worker/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "worker": "node --env-file-if-exists=.env src/worker/index.ts",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.ts",
    "user:create": "node --env-file-if-exists=.env src/scripts/create-user.ts",
    "model:prepare": "node --env-file-if-exists=.env src/scripts/model-prepare.ts",
    "demo:fixtures": "node src/scripts/demo-fixtures.ts",
    "demo:images": "node --env-file-if-exists=.env src/scripts/demo-image-server.ts",
    "demo:seed": "node --env-file-if-exists=.env src/scripts/demo-seed.ts",
    "bench:visual": "node --env-file-if-exists=.env src/scripts/bench-visual.ts",
    "bench:load": "node --env-file-if-exists=.env src/scripts/bench-load.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "@huggingface/transformers": "4.3.0",
    "csv-parse": "7.0.2",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "graphile-worker": "0.18.0",
    "iconv-lite": "0.7.3",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "zod": "4.6.5",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.103.2",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-image-crop": "11.1.2",
    "react-router": "8.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
