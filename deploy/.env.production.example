# Copy to deploy/.env.production on the server (chmod 600). Never commit the real file.
APP_DOMAIN=catalogo.example.it
PUBLIC_ORIGIN=https://catalogo.example.it
POSTGRES_USER=comparator
POSTGRES_PASSWORD=__generate_a_long_random_password__
DATABASE_URL=postgres://comparator:__same_password__@postgres:5432/comparator
COOKIE_SECURE=true
STORAGE_DRIVER=s3
S3_ENDPOINT=https://__your_s3_endpoint__
S3_REGION=__region__
S3_BUCKET=__private_bucket__
S3_ACCESS_KEY_ID=__key_id__
S3_SECRET_ACCESS_KEY=__secret__
S3_FORCE_PATH_STYLE=true
VISION_MODEL=siglip2-base-p16-224
VISION_THREADS=2
VISION_CONCURRENCY=2
VISION_ALLOW_REMOTE_MODELS=true
WORKER_CONCURRENCY=4
EMBED_QUEUE_SHARDS=1
IMAGE_FETCH_DEV_ALLOW=
PHOTO_SEARCH_RETENTION_HOURS=72
METRICS_TOKEN=__random_token__
# openssl rand -base64 32 — store a copy in the password manager with the backups
SECRETS_KEY=__generate_32_bytes_base64__
LOG_LEVEL=info
